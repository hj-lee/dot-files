#!/usr/bin/env python3
"""cmux-gen-config -- regenerate cmux/cmux.json from its two sources.

Deep-merges the gitignored cmux/cmux.local.json (host overrides) over the
tracked cmux/cmux.default.json and writes the result to cmux/cmux.json, the
path ~/.config/cmux/cmux.json links to (setup-zsh.zsh step 6). cmux.json has
no include mechanism and beats the app's saved Settings, which is why the
merge happens here instead of in the app.

    cmux-gen-config [-n|--dry-run]

When the target already exists it is compared first: an identical merge
leaves it untouched, a differing one is shown as a unified diff before being
replaced, and a target missing the GENERATED marker (hand-edited or foreign)
is backed up to the next free cmux.json.bak-N instead of overwritten.

After a real change, runs `cmux reload-config' if cmux is on PATH.
"""

import difflib
import json
import shutil
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
DEFAULT = REPO / "cmux" / "cmux.default.json"
LOCAL = REPO / "cmux" / "cmux.local.json"
TARGET = REPO / "cmux" / "cmux.json"

MARKER = "// GENERATED by cmux-gen-config -- do not edit."
HEADER = (
    f"{MARKER}\n"
    "// Merged from cmux.default.json (tracked) and cmux.local.json\n"
    "// (gitignored, optional). Edit those and re-run cmux-gen-config.\n"
)


def strip_jsonc(text: str) -> str:
    """Drop // and /* */ comments without touching them inside strings."""
    out = []
    i, n = 0, len(text)
    in_string = False
    while i < n:
        c = text[i]
        if in_string:
            out.append(c)
            if c == "\\" and i + 1 < n:
                out.append(text[i + 1])
                i += 1
            elif c == '"':
                in_string = False
        elif c == '"':
            in_string = True
            out.append(c)
        elif c == "/" and i + 1 < n and text[i + 1] == "/":
            while i < n and text[i] != "\n":
                i += 1
            continue
        elif c == "/" and i + 1 < n and text[i + 1] == "*":
            end = text.find("*/", i + 2)
            i = n if end == -1 else end + 2
            continue
        else:
            out.append(c)
        i += 1
    return "".join(out)


def load(path: Path) -> dict:
    data = json.loads(strip_jsonc(path.read_text()))
    if not isinstance(data, dict):
        sys.exit(f"cmux-gen-config: {path} is not a JSON object")
    return data


def deep_merge(base: dict, override: dict) -> dict:
    """Dicts merge recursively; anything else in override replaces base's."""
    merged = dict(base)
    for key, value in override.items():
        if isinstance(merged.get(key), dict) and isinstance(value, dict):
            merged[key] = deep_merge(merged[key], value)
        else:
            merged[key] = value
    return merged


def next_backup(target: Path) -> Path:
    n = 1
    while Path(f"{target}.bak-{n}").exists():
        n += 1
    return Path(f"{target}.bak-{n}")


def main() -> None:
    args = sys.argv[1:]
    dry_run = False
    if args in (["-n"], ["--dry-run"]):
        dry_run = True
    elif args in (["-h"], ["--help"]):
        print(__doc__.strip())
        return
    elif args:
        sys.exit(f"cmux-gen-config: unknown arguments: {' '.join(args)}")

    if not DEFAULT.is_file():
        sys.exit(f"cmux-gen-config: no {DEFAULT}")

    merged = load(DEFAULT)
    if LOCAL.is_file():
        merged = deep_merge(merged, load(LOCAL))
        print(f"merging {LOCAL.name} over {DEFAULT.name}")
    else:
        print(f"no {LOCAL.name} -- using {DEFAULT.name} alone")

    new_text = HEADER + json.dumps(merged, indent=2) + "\n"

    old_text = TARGET.read_text() if TARGET.is_file() else None
    if old_text == new_text:
        print(f"{TARGET.name} is up to date")
        return

    if old_text is not None:
        sys.stdout.writelines(
            difflib.unified_diff(
                old_text.splitlines(keepends=True),
                new_text.splitlines(keepends=True),
                fromfile=f"{TARGET.name} (current)",
                tofile=f"{TARGET.name} (new)",
            )
        )
        if MARKER not in old_text:
            backup = next_backup(TARGET)
            print(f"{TARGET.name} was not generated by this script -- keeping it as {backup.name}")
            if not dry_run:
                TARGET.rename(backup)

    if dry_run:
        print(f"dry run -- would write {TARGET}")
        return

    TARGET.write_text(new_text)
    print(f"wrote {TARGET}")

    if shutil.which("cmux"):
        result = subprocess.run(["cmux", "reload-config"], capture_output=True, text=True)
        if result.returncode == 0:
            print("cmux reload-config: applied")
        else:
            print(f"cmux reload-config failed ({result.stderr.strip() or result.returncode})"
                  " -- reload manually")
    else:
        print("cmux not on PATH -- run `cmux reload-config' to apply")


if __name__ == "__main__":
    main()
